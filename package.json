{
  "name": "ears",
  "version": "1.0.0",
  "description": "A live music set in the terminal: Claude DJs propose SuperCollider changes, measure what comes out of the speakers, and a human says yes or no.",
  "scripts": {
    "ears": "tsx tui/app.tsx",
    "ears:stage": "sh tui/ears.sh",
    "ears:ref": "tsx tui/make-ref.ts",
    "ears:reset": "cp tui/set.start/*.scd tui/set/",
    "ears:tail": "tsx tui/tail.ts",
    "test:ears": "tsx --test tui/tests/*.test.ts",
    "ears:bench": "EARS_PORT=57300 EARS_SC_PORT=57190 EARS_NO_GLUE=1 tsx tui/dev/bench.ts",
    "ears:why": "tsx tui/why.ts",
    "ears:recap": "tsx tui/recap.ts",
    "ears:demo-check": "python3 tui/dev/check-ambient-demo-ui.py",
    "typecheck:ears": "tsc -p tui/tsconfig.json",
    "ears:transcript": "tsx tui/transcript.ts"
  },
  "keywords": [],
  "author": "Joao Viana",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "asciichart": "^1.5.25",
    "cfonts": "^3.3.1",
    "chokidar": "^5.0.0",
    "ears-protocol": "git+https://github.com/joaoviana/ears-protocol.git",
    "gradient-string": "^3.0.0",
    "ink": "^6.8.0",
    "osc-min": "^2.1.2",
    "react": "^19.3.0"
  },
  "private": true
}
