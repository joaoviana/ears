{
  "name": "soundcheck",
  "version": "1.0.0",
  "description": "One brief, several audio engines: hear what Strudel, Tone.js, Faust and Glicol each sound like before choosing a stack.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postinstall": "node scripts/copy-faust.mjs",
    "check:faust": "node scripts/faust-check.mjs",
    "render": "sh scripts/render.sh",
    "ears": "tsx tui/app.tsx",
    "ears:stage": "sh tui/ears.sh",
    "ears:ref": "tsx tui/make-ref.ts",
    "ears:reset": "cp tui/set.start/*.scd tui/set/",
    "ears:tail": "tsx tui/tail.ts",
    "test:ears": "tsx --test tui/tests/*.test.ts",
    "ears:bench": "EARS_PORT=57300 EARS_SC_PORT=57190 EARS_NO_GLUE=1 tsx tui/dev/bench.ts",
    "ears:why": "tsx tui/why.ts",
    "ears:recap": "tsx tui/recap.ts",
    "ears:demo-check": "python3 tui/dev/check-ambient-demo-ui.py",
    "typecheck:ears": "tsc -p tui/tsconfig.json",
    "ears:transcript": "tsx tui/transcript.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@grame/faustwasm": "^0.18.4",
    "@inkjs/ui": "^2.0.0",
    "@strudel/web": "^1.3.0",
    "asciichart": "^1.5.25",
    "cfonts": "^3.3.1",
    "chokidar": "^5.0.0",
    "ears-protocol": "file:../ears-protocol",
    "glicol": "^0.4.0",
    "gradient-string": "^3.0.0",
    "ink": "^6.8.0",
    "osc-min": "^2.1.2",
    "react": "^19.3.0",
    "tone": "^15.1.22"
  },
  "private": true
}
