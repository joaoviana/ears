import { spawn } from "child_process";
const mk = (limits: boolean) => JSON.stringify({ type: "object", additionalProperties: false, required: ["slot", "set", "why", "evidence"], properties: { slot: { enum: ["d1", "d2", "d3", "d4"] }, replace: { type: "boolean" }, remove: { type: "array", items: { type: "string" } }, set: { type: "array", ...(limits ? { minItems: 1, maxItems: 12 } : {}), items: { type: "object", additionalProperties: false, required: ["key", "value"], properties: { key: { type: "string" }, value: { type: "string" } } } }, why: { type: "string" }, evidence: { type: "string" } } });
const run = (schema: string, model: string) => new Promise<string>((res) => { const t = Date.now(); const p = spawn("claude", ["-p", "Slot d3 is a bass with cutoff 3800. The report says: sub -5 dB thin, centroid +40% bright. Patch it.", "--system-prompt", "You patch one slot: set is a list of key/value edits.", "--json-schema", schema, "--output-format", "json", "--model", model, "--tools", "", "--strict-mcp-config", "--setting-sources", "", "--no-session-persistence"], { stdio: ["ignore", "pipe", "pipe"] }); let o = "", e = ""; p.stdout.on("data", (d) => (o += d)); p.stderr.on("data", (d) => (e += d)); const k = setTimeout(() => { p.kill(); res("TIMEOUT 30s"); }, 30000); p.on("close", () => { clearTimeout(k); let so = ""; try { so = JSON.stringify(JSON.parse(o).structured_output); } catch { so = o.slice(0, 200); } res(`${((Date.now() - t) / 1000).toFixed(1)}s ${so.slice(0, 160)} ${e.slice(0, 100)}`); }); });
console.log("no limits, haiku :", await run(mk(false), "haiku"));
console.log("no limits, sonnet:", await run(mk(false), "sonnet"));
console.log("limits,    sonnet:", await run(mk(true), "sonnet"));
